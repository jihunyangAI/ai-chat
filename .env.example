# Anthropic API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# MongoDB 연결 문자열 (Atlas: mongodb+srv://... / 로컬: mongodb://localhost:27017/ai-chat)
MONGODB_URI=

# 앱 표시 이름 (헤더 및 브라우저 탭에 표시)
NEXT_PUBLIC_APP_NAME=AI Chat

# Google Cloud 설정 (Cloud Run 배포 시 필요)
GCP_PROJECT_ID=
GCP_REGION=asia-northeast3
